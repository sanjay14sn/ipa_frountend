{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // No "entry" override: fallow's Next.js auto-detection correctly treats
  // app/**/{page,layout,route,...} as entry points for this repo.
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
  },
  // tailwindcss-animate: loaded via require() in tailwind.config.ts, which
  // fallow classifies as a non-production file (reported "test-only").
  // postcss-load-config: referenced only by a JSDoc @type comment in
  // postcss.config.mjs; the actual loader ships inside Next.js.
  "ignoreDependencies": [
    "tailwindcss-animate",
    "postcss-load-config"
  ],
  "rules": {
    "unused-dependencies": "warn"
  }
}
