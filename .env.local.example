# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# REQUIRED — API server base URL. Must be set in all environments.
NEXT_PUBLIC_API_URL=http://localhost:5500

# Observability
NEXT_PUBLIC_CLIENT_TELEMETRY_ENABLED=true
FRONTEND_TELEMETRY_ENABLED=true
LOG_APP_NAME=ipa-frontend

# GST rate as a decimal (e.g. 0.18 = 18%). Must match backend GST_RATE. Defaults to 0.18 if unset.
# NEXT_PUBLIC_GST_RATE=0.18
